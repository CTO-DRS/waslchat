# وصل سيرفر — المتغيرات الموثقة (2.0.0)
# انسخه: cp .env.example .env — ثم ولّد كل سرّ بـ: openssl rand -base64 32
# لا قيمة افتراضية آمنة هنا عمداً — الفارغ يعني «الميزة معطلة بصدق» ولا ينفجر.

# ————— الاتصال بـSupabase ذاتي الاستضافة (من توزيعتها الرسمية §2) —————
# داخل شبكة الدوكر: اسم حاوية db الخاصة بتوزيعة Supabase
POSTGRES_HOST=supabase-db
POSTGRES_DB=postgres
POSTGRES_PASSWORD=غيّرني_openssl_rand_base64_32
SUPABASE_URL=https://supabase.دومينك.example
# مفتاح service_role المولد من JWT_SECRET بتوزيعتك — لا يُنشر أبداً
SUPABASE_SERVICE_ROLE_KEY=غيّرني_من_توزيعة_supabase

# مجلد وسائط التوزيعة الرسمية (docker volume ls لمعرفة الاسم الفعلي)
STORAGE_VOLUME=supabase_storage

# ————— دوال Edge السبع (SELF_HOSTING.md §5) —————
# push وevent-reminders: اختياري — بلا حساب Firebase لا إشعارات وكل الباقي يعمل
FCM_SERVICE_ACCOUNT=
WEBHOOK_SECRET=
# ويب Web Push (ترحيل 036): زوج VAPID أنت تولّده بمكتبة web-push القياسية
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
# ai وmoderation-ai: اختياري — بلا مفتاح تعمل المحركات المحلية فقط
# وترد الدالة بخطأ واضح (لا انهيار ولا ادعاء)
GEMINI_API_KEY=
GEMINI_MODEL=

# ————— TURN للمكالمات (§6) —————
TURN_REALM=turn.دومينك.example
TURN_USER=wasl
TURN_PASSWORD=غيّرني_openssl_rand_base64_32
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# ————— النسخ الاحتياطي (§8) —————
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
